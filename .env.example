# Copy to .env and edit paths/values for your environment

# --- Shared (both scripts) ---
# FOLDER_PATH, FILE_PATH, RECURSIVE

# Folder containing workbooks to process (preferred over FILE_PATH when set)
# Leave empty to use FILE_PATH instead
FOLDER_PATH=

# Single workbook to process (used when FOLDER_PATH is empty)
FILE_PATH=C:\path\to\file

# When FOLDER_PATH is set: true/1/yes to include .xlsx files in subfolders
RECURSIVE=false

# --- generate-voucher.ps1 ---
# SHEET_NAME, SHEET_RANGE, TARGET_CELLS_N, LOG_PATH

# Name of the template sheet to copy from when creating new numbered sheets
SHEET_NAME=1

# Inclusive range of numbered sheets to create or update (start,stop)
SHEET_RANGE=3,5

# Log file path (relative paths resolve from the script directory)
# Change before running each script (e.g. logs\payroll-update.log or logs\fix-copied-payroll-sheet.log)
LOG_PATH=logs\payroll-update.log

# Minimum log level: TRACE, DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=info

# Comma-separated cell groups; each group uses its matching SHEET_REF_INDEX_N
TARGET_CELLS_1=B5,I11,G12,G13,G14,G15,G16,L11
TARGET_CELLS_2=I41,G42,G43,G45,G46,G47,L41

# Cells that may need fixing (no increment)
# TARGET_CELLS_1=B6,L4,A19,l11
# TARGET_CELLS_2=

# --- fix-copied-payroll-sheet.ps1 ---
# TARGET_CELLS_N, SHEET_REF_INDEX_N, LOG_PATH, ONLY_NUM_SHEETS, DRY_RUN, STRIP_EXTERNAL_PATH_ONLY
#
# Preview changes:
#   .\fix-copied-payroll-sheet.ps1 -DryRun
# Apply changes:
#   .\fix-copied-payroll-sheet.ps1

# 1-based visible-sheet index; sheet tab name is written into formulas for TARGET_CELLS_N
SHEET_REF_INDEX_1=1
SHEET_REF_INDEX_2=2

# true/1/yes to only process sheets with integer tab names (e.g. 1, 2, 3)
ONLY_NUM_SHEETS=true

# true/1/yes to log changes without saving (overridden by -DryRun switch)
DRY_RUN=false

# true/1/yes: only rewrite UNC external refs (\\...\ [*.xlsx]); skip already-local refs
# false (default): rewrite any 'SheetName'! prefix (current behavior)
STRIP_EXTERNAL_PATH_ONLY=false

# --- shift-payroll-ref-column.ps1 ---
# TARGET_CELLS_N, LOG_PATH, ONLY_NUM_SHEETS, DRY_RUN, INCREMENT_MODE
#
# Preview changes:
#   .\shift-payroll-ref-column.ps1 -DryRun
# Apply changes:
#   .\shift-payroll-ref-column.ps1

# true/1/yes to increment column letters; false to decrement
INCREMENT_MODE=true

# --- lock-sheets.ps1 / unlock-sheets.ps1 ---
# SHEET_RANGE, SHEET_PASSWORD, LOG_PATH
#
# Lock sheets in range:
#   .\lock-sheets.ps1
# Unlock sheets in range:
#   .\unlock-sheets.ps1

# Password for worksheet Protect / Unprotect
SHEET_PASSWORD=

# --- check-files-cutoff.ps1 ---
# BRANCH_PATHS, BRANCH_PAYROLL_START_DAY, BRANCH_PAYROLL_END_DAY,
# PAYROLL_TARGET_PERIOD, REF_RUN_DATE, DATE_SUBPATH,
# USE_BRANCH_YEAR_MONTH, BRANCH_YEAR, BRANCH_MONTH (legacy),
# LOG_PATH, REFRESH_INTERVAL_SECONDS,
# CUTOFF_FILE_EXTENSIONS, RECURSIVE, DIR_LEVEL_SEARCH,
# SR_PATHS, SR_FILE_EXTENSIONS, SR_OPEN_MAX, SHOW_SR_BUTTON
#
# Check which branch folders have a cutoff file for the payroll week:
#   .\check-files-cutoff.ps1
# Skip the popup (log/console only):
#   .\check-files-cutoff.ps1 -NoPopup

# Payroll week start/end weekdays (default Wed–Tue, same as dmpc-payroll)
BRANCH_PAYROLL_START_DAY=Wednesday
BRANCH_PAYROLL_END_DAY=Tuesday

# current = period ending on/before today; previous = week before current; next = upcoming period (default)
PAYROLL_TARGET_PERIOD=next

# Optional fixed "today" for period math (yyyy-MM-dd); leave empty to use today
REF_RUN_DATE=

# Auto re-check interval in seconds; 0 or empty = run once (default)
REFRESH_INTERVAL_SECONDS=0

# File extensions to treat as cutoff files (semicolon-separated; leading dot optional)
CUTOFF_FILE_EXTENSIONS=.xlsx;.xls

# When true, also search subfolders under each branch path (depth limited below)
RECURSIVE=false
# Max subdirectory depth when RECURSIVE=true (0 = branch folder only)
DIR_LEVEL_SEARCH=2

# Preferred: append year + fuzzy month folder from payroll period start
# Tokens: yyyy, MMMM, MMM, MM, M. Glob * / ? allowed per segment (case-insensitive).
# Cross-month weeks use the period start month. When set, legacy keys below are ignored.
DATE_SUBPATH=\yyyy\*MMM

# Legacy (used only when DATE_SUBPATH is empty): append BRANCH_YEAR\BRANCH_MONTH
# USE_BRANCH_YEAR_MONTH=true
# BRANCH_YEAR=2026
# BRANCH_MONTH=7. July

# One branch per line (Label=base FolderPath). DATE_SUBPATH (or legacy year/month) appended when set.
# Alt folders: Name-1, Name-2, ... group under the same display name; any match = OK.
# You can also put several on one line with ';'
BRANCH_PATHS=Pandesalan-1=\\server\path\to\signature
BRANCH_PATHS=Pandesalan-2=\\server\path\to\voucher
BRANCH_PATHS=Mindoro=\\server\path\to\incentives

# Sales report folders (Label must match BRANCH_PATHS group label after -N suffix stripping)
SR_PATHS=Pandesalan=\\server\path\to\sales-reports
SR_PATHS=Mindoro=\\server\path\to\sales-reports

# File extensions for Open SR search (semicolon-separated; leading dot optional)
SR_FILE_EXTENSIONS=.pdf;.png;.jpg;.jpeg;.xlsx;.xls

# Max sales report files to open per Open SR click
SR_OPEN_MAX=10

# true/1/yes to show the Open SR button in the cutoff popup (default true)
SHOW_SR_BUTTON=true
