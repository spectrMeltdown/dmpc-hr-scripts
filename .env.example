# Copy to .env and edit paths/values for your environment

# --- Shared (both scripts) ---
# FOLDER_PATH, FILE_PATH, RECURSIVE

# Folder containing workbooks to process (preferred over FILE_PATH when set)
# Leave empty to use FILE_PATH instead
FOLDER_PATH=

# Single workbook to process (used when FOLDER_PATH is empty)
FILE_PATH=c:\Users\w\SSD\Code\dmpc-payroll-update\test\payroll-test.xlsx

# When FOLDER_PATH is set: true/1/yes to include .xlsx files in subfolders
RECURSIVE=false

# --- generate-voucher.ps1 ---
# SHEET_NAME, SHEET_RANGE, TARGET_CELLS_N, LOG_PATH

# Name of the template sheet to copy from when creating new numbered sheets
SHEET_NAME=1

# Inclusive range of numbered sheets to create or update (start,stop)
SHEET_RANGE=3,5

# Log file path (relative paths resolve from the script directory)
# Change before running each script (e.g. logs\payroll-update.log or logs\fix-copied-payroll-sheet.log)
LOG_PATH=logs\payroll-update.log

# Comma-separated cell groups; each group uses its matching SHEET_REF_INDEX_N
TARGET_CELLS_1=B5,I11,G12,G13,G14,G15,G16
TARGET_CELLS_2=I41,G42,G43,G45,G46,G47

# --- fix-copied-payroll-sheet.ps1 ---
# TARGET_CELLS_N, SHEET_REF_INDEX_N, LOG_PATH, ONLY_NUM_SHEETS, DRY_RUN
#
# Preview changes:
#   .\fix-copied-payroll-sheet.ps1 -DryRun
# Apply changes:
#   .\fix-copied-payroll-sheet.ps1

# 1-based visible-sheet index; sheet tab name is written into formulas for TARGET_CELLS_N
SHEET_REF_INDEX_1=1
SHEET_REF_INDEX_2=2

# true/1/yes to only process sheets with integer tab names (e.g. 1, 2, 3)
ONLY_NUM_SHEETS=false

# true/1/yes to log changes without saving (overridden by -DryRun switch)
DRY_RUN=false

# --- lock-sheets.ps1 / unlock-sheets.ps1 ---
# SHEET_RANGE, SHEET_PASSWORD, LOG_PATH
#
# Lock sheets in range:
#   .\lock-sheets.ps1
# Unlock sheets in range:
#   .\unlock-sheets.ps1

# Password for worksheet Protect / Unprotect
SHEET_PASSWORD=
