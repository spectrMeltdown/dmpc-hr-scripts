# Copy to .env and edit paths/values for your environment

# Folder containing workbooks to process (preferred over FILE_PATH when set)
# Leave empty to use FILE_PATH instead
FOLDER_PATH=

# Single workbook to process (used when FOLDER_PATH is empty)
FILE_PATH=c:\Users\w\SSD\Code\dmpc-payroll-update\test\payroll-test.xlsx

# When FOLDER_PATH is set: true/1/yes to include .xlsx files in subfolders
RECURSIVE=false

# Name of the template sheet to copy from when creating new numbered sheets
SHEET_NAME=1

# Inclusive range of numbered sheets to create or update (start,stop)
SHEET_RANGE=3,5

# Log file path (relative paths resolve from the script directory)
LOG_PATH=logs\payroll-update.log

# Comma-separated cell addresses whose external-reference row numbers are adjusted
TARGET_CELLS=B5,I11,G12,G13,G14,G15,G16,I41,G42,G43,G45,G46,G47
